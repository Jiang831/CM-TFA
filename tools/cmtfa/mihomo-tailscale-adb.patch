index 00000000..8b8e486f
--- /dev/null
+++ b/config/tailscale_adb_test.go
@@ -0,0 +1,54 @@
+//go:build with_gvisor && !no_tailscale
+
+package config_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/metacubex/mihomo/config"
+	_ "github.com/metacubex/mihomo/hub/executor"
+)
+
+func TestTailscaleADBProfile(t *testing.T) {
+	const profile = `
+proxies:
+  - name: Tailnet
+    type: tailscale
+    hostname: cmtfa-test
+    state-dir: tailscale/cmtfa-test
+listeners:
+  - name: tailscale-adb-5555
+    type: tailscale
+    hostname: cmtfa-test
+    state-dir: ./tailscale/cmtfa-test
+    forwards:
+      - listen: 5555
+        target: 127.0.0.1:5555
+        network: tcp
+        proxy: DIRECT
+`
+	t.Run("R10 syntax uses existing outbound", func(t *testing.T) {
+		cfg, err := config.Parse([]byte(profile))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer cfg.Proxies["Tailnet"].Close()
+		ln := cfg.Listeners["tailscale-adb-5555"]
+		if ln == nil || ln.Address() != ":5555" {
+			t.Fatalf("expected Tailscale ADB listener on :5555, got %v", ln)
+		}
+	})
+	t.Run("reject non-local target", func(t *testing.T) {
+		_, err := config.Parse([]byte(strings.Replace(profile, "127.0.0.1:5555", "192.0.2.1:5555", 1)))
+		if err == nil || !strings.Contains(err.Error(), "requires TCP 5555") {
+			t.Fatalf("expected local-target validation, got %v", err)
+		}
+	})
+	t.Run("reject mismatched state directory", func(t *testing.T) {
+		_, err := config.Parse([]byte(strings.Replace(profile, "./tailscale/cmtfa-test", "tailscale/other", 1)))
+		if err == nil || !strings.Contains(err.Error(), "matching Tailscale outbound") {
+			t.Fatalf("expected an outbound identity mismatch, got %v", err)
+		}
+	})
+}
