diff --git a/listener/tailscale_adb.go b/listener/tailscale_adb.go
new file mode 100644
index 00000000..affc363d
--- /dev/null
+++ b/listener/tailscale_adb.go
@@ -0,0 +1,157 @@
+package listener
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/metacubex/mihomo/adapter/outbound"
+	N "github.com/metacubex/mihomo/common/net"
+	"github.com/metacubex/mihomo/common/structure"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/log"
+)
+
+const adbPort = ":5555"
+const adbTarget = "127.0.0.1" + adbPort
+
+type tailscaleADBConfig struct {
+	Name     string `inbound:"name"`
+	Hostname string `inbound:"hostname"`
+	StateDir string `inbound:"state-dir"`
+	Forwards []struct {
+		Listen  int    `inbound:"listen"`
+		Target  string `inbound:"target"`
+		Network string `inbound:"network"`
+		Proxy   string `inbound:"proxy"`
+	} `inbound:"forwards"`
+}
+
+type tailscaleADBNode interface {
+	TailscaleADBIdentity() (host, stateDir string)
+	ListenTailscaleADB(context.Context) (net.Listener, error)
+}
+
+type tailscaleADB struct {
+	name   string
+	node   tailscaleADBNode
+	owner  C.ProxyAdapter
+	cancel context.CancelFunc
+	done   chan struct{}
+}
+
+func ParseTailscaleADB(mapping map[string]any, proxies map[string]C.Proxy) (C.InboundListener, error) {
+	for key := range mapping {
+		switch key {
+		case "type", "name", "hostname", "state-dir", "forwards":
+		default:
+			return nil, fmt.Errorf("unsupported Tailscale ADB listener option %q; set node options on its outbound", key)
+		}
+	}
+	decoder := structure.NewDecoder(structure.Option{TagName: "inbound", WeaklyTypedInput: true})
+	var cfg tailscaleADBConfig
+	if err := decoder.Decode(mapping, &cfg); err != nil {
+		return nil, err
+	}
+	if strings.TrimSpace(cfg.Name) == "" || cfg.Hostname == "" || cfg.StateDir == "" {
+		return nil, fmt.Errorf("Tailscale ADB listener requires name, hostname and state-dir")
+	}
+	if len(cfg.Forwards) != 1 {
+		return nil, fmt.Errorf("Tailscale ADB listener requires a single TCP forward")
+	}
+	forward := cfg.Forwards[0]
+	if forward.Listen != 5555 || forward.Target != adbTarget || forward.Network != "tcp" || forward.Proxy != "DIRECT" {
+		return nil, fmt.Errorf("Tailscale ADB listener requires TCP 5555 to %s with proxy DIRECT", adbTarget)
+	}
+
+	stateDir := filepath.Clean(C.Path.Resolve(cfg.StateDir))
+	var match *tailscaleADB
+	for _, proxy := range proxies {
+		owner := proxy.Adapter()
+		node, ok := outbound.TailscaleADBAdapter(owner).(tailscaleADBNode)
+		if !ok {
+			continue
+		}
+		host, dir := node.TailscaleADBIdentity()
+		if filepath.Clean(dir) != stateDir {
+			continue
+		}
+		if match != nil || host != cfg.Hostname {
+			return nil, fmt.Errorf("Tailscale ADB listener needs a unique matching outbound hostname and state-dir")
+		}
+		match = &tailscaleADB{name: cfg.Name, node: node, owner: owner}
+	}
+	if match == nil {
+		return nil, fmt.Errorf("Tailscale ADB listener needs a matching Tailscale outbound")
+	}
+	return match, nil
+}
+
+func (t *tailscaleADB) Name() string            { return t.name }
+func (t *tailscaleADB) Address() string         { return adbPort }
+func (t *tailscaleADB) RawAddress() string      { return t.Address() }
+func (t *tailscaleADB) Config() C.InboundConfig { return t }
+
+func (t *tailscaleADB) Equal(other C.InboundConfig) bool {
+	// A new profile creates a new outbound even when the YAML has the same values.
+	return other == t
+}
+
+func (t *tailscaleADB) Listen(_ C.Tunnel) error {
+	ctx, cancel := context.WithCancel(context.Background())
+	t.cancel = cancel
+	t.done = make(chan struct{})
+	go func() {
+		defer close(t.done)
+		t.serve(ctx)
+	}()
+	return nil
+}
+
+func (t *tailscaleADB) serve(ctx context.Context) {
+	ln, err := t.node.ListenTailscaleADB(ctx)
+	if err != nil {
+		if ctx.Err() == nil {
+			log.Errorln("Tailscale ADB listener %s: %v", t.name, err)
+		}
+		return
+	}
+	defer ln.Close()
+	stop := context.AfterFunc(ctx, func() { _ = ln.Close() })
+	defer stop()
+	log.Infoln("Tailscale ADB listener %s registered on TCP %s", t.name, adbPort)
+	for {
+		conn, err := ln.Accept()
+		if err != nil {
+			if ctx.Err() == nil {
+				log.Warnln("Tailscale ADB listener %s: %v", t.name, err)
+			}
+			return
+		}
+		go relayADB(ctx, conn)
+	}
+}
+
+func relayADB(ctx context.Context, conn net.Conn) {
+	defer conn.Close()
+	dialer := net.Dialer{Timeout: 5 * time.Second}
+	local, err := dialer.DialContext(ctx, "tcp4", adbTarget)
+	if err != nil {
+		log.Debugln("Tailscale ADB could not connect to Android loopback: %v", err)
+		return
+	}
+	_ = N.RelayContext(ctx, conn, local)
+}
+
+func (t *tailscaleADB) Close() error {
+	if t.cancel != nil {
+		t.cancel()
+		<-t.done
+		t.cancel = nil
+		return t.owner.Close()
+	}
+	return nil
+}
