diff --git a/listener/tailscale_test.go b/listener/tailscale_test.go
new file mode 100644
index 00000000..831f2ea4
--- /dev/null
+++ b/listener/tailscale_test.go
@@ -0,0 +1,200 @@
+//go:build with_gvisor && !no_tailscale
+
+package listener
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"testing"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/transport/socks5"
+)
+
+type testTailscaleServer struct {
+	tcp      *testTailscaleTCP
+	udp      []*testTailscaleUDP
+	failUDP6 bool
+}
+
+func (s *testTailscaleServer) Listen(_, _ string) (net.Listener, error) {
+	s.tcp = &testTailscaleTCP{incoming: make(chan net.Conn, 1), closed: make(chan struct{})}
+	return s.tcp, nil
+}
+
+func (s *testTailscaleServer) ListenPacket(_, address string) (net.PacketConn, error) {
+	if s.failUDP6 && address == "[fd7a:115c:a1e0::2]:5353" {
+		return nil, errors.New("test bind failure")
+	}
+	socket := &testTailscaleUDP{
+		address:  net.UDPAddrFromAddrPort(netip.MustParseAddrPort(address)),
+		incoming: make(chan []byte, 1),
+		replies:  make(chan string, 1),
+		closed:   make(chan struct{}),
+	}
+	s.udp = append(s.udp, socket)
+	return socket, nil
+}
+
+func (*testTailscaleServer) TailscaleIPs() (netip.Addr, netip.Addr) {
+	return netip.MustParseAddr("100.64.0.2"), netip.MustParseAddr("fd7a:115c:a1e0::2")
+}
+
+type testTailscaleTCP struct {
+	net.Listener
+	incoming chan net.Conn
+	closed   chan struct{}
+}
+
+func (s *testTailscaleTCP) Accept() (net.Conn, error) {
+	select {
+	case <-s.closed:
+		return nil, net.ErrClosed
+	case conn := <-s.incoming:
+		return conn, nil
+	}
+}
+
+func (s *testTailscaleTCP) Close() error {
+	close(s.closed)
+	return nil
+}
+
+type testTailscaleUDP struct {
+	net.PacketConn
+	address  *net.UDPAddr
+	incoming chan []byte
+	replies  chan string
+	closed   chan struct{}
+}
+
+func (s *testTailscaleUDP) LocalAddr() net.Addr { return s.address }
+
+func (s *testTailscaleUDP) ReadFrom(buffer []byte) (int, net.Addr, error) {
+	select {
+	case <-s.closed:
+		return 0, nil, net.ErrClosed
+	case data := <-s.incoming:
+		return copy(buffer, data), &net.UDPAddr{IP: net.IPv4(100, 64, 0, 4), Port: 12345}, nil
+	}
+}
+
+func (s *testTailscaleUDP) WriteTo(data []byte, _ net.Addr) (int, error) {
+	s.replies <- string(data)
+	return len(data), nil
+}
+
+func (s *testTailscaleUDP) Close() error {
+	close(s.closed)
+	return nil
+}
+
+type tailscaleTestPacket struct {
+	metadata *C.Metadata
+	key      string
+}
+
+type tailscaleTestTunnel struct {
+	C.Tunnel
+	tcp chan *C.Metadata
+	udp chan tailscaleTestPacket
+}
+
+func (t tailscaleTestTunnel) HandleTCPConn(conn net.Conn, metadata *C.Metadata) {
+	t.tcp <- metadata
+	_ = conn.Close()
+}
+
+func (t tailscaleTestTunnel) HandleUDPPacket(packet C.UDPPacket, metadata *C.Metadata) {
+	t.udp <- tailscaleTestPacket{metadata, C.NewPacketAdapter(packet, metadata).Key()}
+	_, _ = packet.WriteBack(packet.Data(), nil)
+	packet.Drop()
+}
+
+func TestTailscaleForwardBindings(t *testing.T) {
+	listener := &tailscaleListener{
+		name: "services",
+		rule: "service-rules",
+		forwards: []tailscaleForward{
+			{network: "tcp", port: "8080", target: socks5.ParseAddr("device.example:8088")},
+			{network: "udp", port: "5353", target: socks5.ParseAddr("device.example:53"), proxy: "custom"},
+		},
+	}
+	tunnel := tailscaleTestTunnel{
+		tcp: make(chan *C.Metadata, 1),
+		udp: make(chan tailscaleTestPacket, 2),
+	}
+
+	t.Run("partial bind closes all sockets", func(t *testing.T) {
+		server := &testTailscaleServer{failUDP6: true}
+		bindings, err := listener.bind(server, tunnel)
+		if err == nil || len(bindings) != 0 || len(server.udp) != 1 {
+			t.Fatalf("expected IPv6 bind failure after one TCP and one UDP bind, got %v", err)
+		}
+		for _, closed := range []chan struct{}{server.tcp.closed, server.udp[0].closed} {
+			select {
+			case <-closed:
+			default:
+				t.Fatal("socket was not closed")
+			}
+		}
+	})
+
+	t.Run("route TCP and both UDP families with separate sessions", func(t *testing.T) {
+		server := &testTailscaleServer{}
+		bindings, err := listener.bind(server, tunnel)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		done := make(chan struct{})
+		go func() {
+			defer close(done)
+			listener.serve(ctx, bindings)
+		}()
+		t.Cleanup(func() {
+			cancel()
+			<-done
+		})
+
+		client, conn := net.Pipe()
+		defer client.Close()
+		server.tcp.incoming <- conn
+		select {
+		case metadata := <-tunnel.tcp:
+			if metadata.RemoteAddress() != "device.example:8088" || metadata.InName != listener.name ||
+				metadata.SpecialRules != listener.rule || metadata.SpecialProxy != "" {
+				t.Fatalf("unexpected TCP metadata: %+v", metadata)
+			}
+		case <-ctx.Done():
+			t.Fatal("TCP connection did not reach the tunnel")
+		}
+
+		if len(server.udp) != 2 {
+			t.Fatalf("opened %d UDP sockets, want 2", len(server.udp))
+		}
+		var previousKey string
+		for _, socket := range server.udp {
+			socket.incoming <- []byte("test")
+			select {
+			case reply := <-socket.replies:
+				if reply != "test" {
+					t.Fatalf("UDP echo = %q", reply)
+				}
+			case <-ctx.Done():
+				t.Fatal("UDP packet did not reach the tunnel")
+			}
+			packet := <-tunnel.udp
+			if packet.metadata.RemoteAddress() != "device.example:53" || packet.metadata.SpecialProxy != "custom" {
+				t.Fatalf("unexpected UDP metadata: %+v", packet.metadata)
+			}
+			if packet.key == previousKey {
+				t.Fatal("UDP sessions for separate sockets have the same key")
+			}
+			previousKey = packet.key
+		}
+	})
+}
